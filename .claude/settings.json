{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/install-godot.sh)",
      "Bash(scripts/install-export-templates.sh)",
      "Bash(python3 pipeline/assets.py:*)",
      "Bash(python3 -m unittest discover -s pipeline/tests:*)",
      "Bash(godot --headless:*)",
      "mcp__godot"
    ]
  },
  "enabledMcpjsonServers": ["godot"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 300 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh", "timeout": 180 }
        ]
      }
    ]
  }
}
